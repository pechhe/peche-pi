script-source,85,node:internal/v8_prof_polyfill,// Copyright 2012 the V8 project authors. All rights reserved.\n// Redistribution and use in source and binary forms\x2C with or without\n// modification\x2C are permitted provided that the following conditions are\n// met:\n//\n//     * Redistributions of source code must retain the above copyright\n//       notice\x2C this list of conditions and the following disclaimer.\n//     * Redistributions in binary form must reproduce the above\n//       copyright notice\x2C this list of conditions and the following\n//       disclaimer in the documentation and/or other materials provided\n//       with the distribution.\n//     * Neither the name of Google Inc. nor the names of its\n//       contributors may be used to endorse or promote products derived\n//       from this software without specific prior written permission.\n//\n// THIS SOFTWARE IS PROVIDED BY THE COPYRIGHT HOLDERS AND CONTRIBUTORS\n// "AS IS" AND ANY EXPRESS OR IMPLIED WARRANTIES\x2C INCLUDING\x2C BUT NOT\n// LIMITED TO\x2C THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR\n// A PARTICULAR PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL THE COPYRIGHT\n// OWNER OR CONTRIBUTORS BE LIABLE FOR ANY DIRECT\x2C INDIRECT\x2C INCIDENTAL\x2C\n// SPECIAL\x2C EXEMPLARY\x2C OR CONSEQUENTIAL DAMAGES (INCLUDING\x2C BUT NOT\n// LIMITED TO\x2C PROCUREMENT OF SUBSTITUTE GOODS OR SERVICES; LOSS OF USE\x2C\n// DATA\x2C OR PROFITS; OR BUSINESS INTERRUPTION) HOWEVER CAUSED AND ON ANY\n// THEORY OF LIABILITY\x2C WHETHER IN CONTRACT\x2C STRICT LIABILITY\x2C OR TORT\n// (INCLUDING NEGLIGENCE OR OTHERWISE) ARISING IN ANY WAY OUT OF THE USE\n// OF THIS SOFTWARE\x2C EVEN IF ADVISED OF THE POSSIBILITY OF SUCH DAMAGE.\n\n'use strict';\n\n/* eslint-disable node-core/prefer-primordials\x2C no-restricted-globals */\n/* global console */\n\nconst {\n  ArrayPrototypePush\x2C\n  ArrayPrototypePushApply\x2C\n  ArrayPrototypeSlice\x2C\n} = primordials;\n\nconst fs = require('fs');\nconst cp = require('child_process');\nconst { Buffer } = require('buffer');\nconst { StringDecoder } = require('string_decoder');\n\nconst os = {\n  system: function(name\x2C args) {\n    if (process.platform === 'linux' && name === 'nm') {\n      // Filter out vdso and vsyscall entries.\n      const arg = args[args.length - 1];\n      if (arg === '[vdso]' ||\n          arg === '[vsyscall]' ||\n          /^[0-9a-f]+-[0-9a-f]+$/.test(arg)) {\n        return '';\n      }\n    }\n    let out = cp.spawnSync(name\x2C args).stdout.toString();\n    // Auto c++filt names\x2C but not [iItT]\n    if (process.platform === 'darwin' && name === 'nm') {\n      // `nm` prints an error along the lines of "Run xcodebuild -license" and\n      // exits when Xcode hasn't been properly installed or when its license\n      // hasn't been accepted yet. Basically any mention of xcodebuild in\n      // the output means the nm command is non-functional.\n      const match = out.match(/(?:^|\\n)([^\\n]*xcodebuild[^\\n]*)(?:\\n|$)/);\n      // eslint-disable-next-line no-restricted-syntax\n      if (match) throw new Error(match[1]);\n      out = macCppfiltNm(out);\n    }\n    return out;\n  }\x2C\n};\nconst print = console.log;\n\nfunction read(fileName) {\n  return fs.readFileSync(fileName\x2C 'utf8');\n}\nconst quit = process.exit;\n\nconst tickArguments = [];\nif (process.platform === 'darwin') {\n  ArrayPrototypePush(tickArguments\x2C '--mac');\n} else if (process.platform === 'win32') {\n  ArrayPrototypePush(tickArguments\x2C '--windows');\n}\nArrayPrototypePushApply(tickArguments\x2C\n                        ArrayPrototypeSlice(process.argv\x2C 1));\n\nfunction write(str) { process.stdout.write(str); };\nfunction printErr(str) { process.stderr.write(str); };\n\nlet logFile;\nlet fd;\nconst buf = Buffer.allocUnsafe(4096);\nconst dec = new StringDecoder('utf-8');\nlet line = '';\n\nfunction openFile(filename) {\n  logFile = filename;\n  try {\n    fd = fs.openSync(logFile\x2C 'r');\n  } catch (e) {\n    console.error(`Cannot access log file: ${logFile}`);\n    console.error('Please provide a valid isolate file as the final argument.');\n    throw e;\n  }\n\n  const message = versionCheck(peekline()\x2C process.versions.v8);\n  if (message) console.log(message);\n}\n\nfunction peekline() {\n  const s = readline();\n  line = `${s}\\n${line}`;\n  return s;\n}\n\nfunction readline() {\n  while (true) {\n    const lineBreak = line.indexOf('\\n');\n    if (lineBreak !== -1) {\n      const res = line.slice(0\x2C lineBreak);\n      line = line.slice(lineBreak + 1);\n      return res;\n    }\n    const bytes = fs.readSync(fd\x2C buf\x2C 0\x2C buf.length);\n    line += dec.write(buf.slice(0\x2C bytes));\n    if (line.length === 0) {\n      return '';\n    }\n    if (bytes === 0) {\n      process.emitWarning(`Profile file ${logFile} is broken`\x2C {\n        code: 'BROKEN_PROFILE_FILE'\x2C\n        detail: `${JSON.stringify(line)} at the file end is broken`\x2C\n      });\n      return '';\n    }\n  }\n}\n\nfunction versionCheck(firstLine\x2C expected) {\n  // v8-version looks like\n  // "v8-version\x2C$major\x2C$minor\x2C$build\x2C$patch[\x2C$embedder]\x2C$candidate"\n  // whereas process.versions.v8 is either "$major.$minor.$build-$embedder" or\n  // "$major.$minor.$build.$patch-$embedder".\n  firstLine = firstLine.split('\x2C');\n  const curVer = expected.split(/[.-]/);\n  if ((firstLine.length !== 6 && firstLine.length !== 7) ||\n      firstLine[0] !== 'v8-version') {\n    return 'Unable to read v8-version from log file.';\n  }\n  // Compare major\x2C minor and build; ignore the patch and candidate fields.\n  for (let i = 0; i < 3; i++)\n    if (curVer[i] !== firstLine[i + 1])\n      return 'Testing v8 version different from logging version';\n}\n\nfunction macCppfiltNm(out) {\n  // Re-grouped copy-paste from `tickprocessor.js`\n  const FUNC_RE = /^([0-9a-fA-F]{8\x2C16} [iItT] )(.*)$/gm;\n  const CLEAN_RE = /^[0-9a-fA-F]{8\x2C16} [iItT] /;\n  let entries = out.match(FUNC_RE);\n  if (entries === null)\n    return out;\n\n  entries = entries.map((entry) => entry.replace(CLEAN_RE\x2C ''));\n\n  let filtered;\n  try {\n    filtered = cp.spawnSync('c++filt'\x2C [ '-p'\x2C '-i' ]\x2C {\n      input: entries.join('\\n')\x2C\n    }).stdout.toString();\n  } catch {\n    return out;\n  }\n\n  let i = 0;\n  filtered = filtered.split('\\n');\n  return out.replace(FUNC_RE\x2C (all\x2C prefix\x2C postfix) => {\n    return prefix + (filtered[i++] || postfix);\n  });\n}\n\nmodule.exports = {\n  globals: {\n    arguments: tickArguments\x2C\n    write\x2C\n    printErr\x2C\n    os\x2C\n    print\x2C\n    read\x2C\n    quit\x2C\n    readline\x2C\n  }\x2C\n  openFile\x2C\n  versionCheck\x2C\n};\n
