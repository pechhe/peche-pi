{
  "name": "@pi-gui/pi-sdk-driver",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "SDK-first session driver spike for pi-gui.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dev-reload-probe": {
      "types": "./dist/dev-reload-probe.d.ts",
      "default": "./dist/dev-reload-probe.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import ./test/register.mjs --test test/*.test.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.78.1",
    "@pi-gui/catalogs": "workspace:*",
    "@pi-gui/session-driver": "workspace:*",
    "undici": "6.21.3"
  }
}
