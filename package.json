{
  "name": "pi-gui",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "pnpm --filter @pi-gui/desktop dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm --filter @pi-gui/session-driver build && pnpm --filter @pi-gui/catalogs build && pnpm --filter @pi-gui/pi-sdk-driver build && pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --if-present test",
    "fallow": "fallow",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health",
    "fallow:audit": "fallow audit",
    "fallow:fix": "fallow fix --dry-run",
    "e2e": "playwright test",
    "test:homebrew-tap": "node scripts/test-update-homebrew-tap.mjs",
    "verify:install-copy": "node scripts/verify-install-copy.mjs",
    "verify:homebrew-flow": "node scripts/verify-homebrew-flow.mjs",
    "release:homebrew-sync": "node scripts/release-homebrew-sync.mjs"
  },
  "pnpm": {
    "overrides": {
      "undici": "6.26.0",
      "fast-uri": "3.1.2",
      "@xmldom/xmldom": "0.9.10",
      "protobufjs": "7.6.3",
      "@protobufjs/utf8": "1.1.1",
      "ws": "8.21.0",
      "tmp": "0.2.7"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^24.13.1",
    "fallow": "^2.91.0",
    "typescript": "^5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "video"
  ]
}
